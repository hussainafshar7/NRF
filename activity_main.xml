<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingBottom="18dp">
   <ImageView android:id="@+id/logo" android:layout_width="62dp" android:layout_height="62dp" android:src="@drawable/noor_logo" android:scaleType="centerInside"/>
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="16dp">
    <TextView android:text="Noor Relief" android:textColor="@color/navy" android:textSize="25sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="Finance Department" android:textColor="@color/gold" android:textSize="15sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp"/>
   </LinearLayout>
  </LinearLayout>
  <TextView android:text="Finance Dashboard" android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="14dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
   <LinearLayout android:layout_width="0dp" android:layout_height="112dp" android:layout_weight="1" android:orientation="vertical" android:background="#FFFFFF" android:padding="16dp" android:layout_marginEnd="7dp">
    <TextView android:text="TOTAL RECEIVED" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/muted" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/received" android:text="AFN 0" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/success" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
   </LinearLayout>
   <LinearLayout android:layout_width="0dp" android:layout_height="112dp" android:layout_weight="1" android:orientation="vertical" android:background="#FFFFFF" android:padding="16dp" android:layout_marginStart="7dp">
    <TextView android:text="TOTAL PAID" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/muted" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/paid" android:text="AFN 0" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/danger" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
   </LinearLayout>
  </LinearLayout>
  <Button android:id="@+id/addPayment" android:text="+  NEW PAYMENT" android:textStyle="bold" android:textColor="@color/white" android:backgroundTint="@color/navy" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp"/>
  <Button android:id="@+id/addReceipt" android:text="+  NEW RECEIPT" android:textStyle="bold" android:textColor="@color/navy" android:backgroundTint="@color/gold" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp"/>
  <Button android:id="@+id/transactions" android:text="VIEW ALL TRANSACTIONS" android:textStyle="bold" android:textColor="@color/navy" android:backgroundTint="@color/white" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp"/>
  <TextView android:text="Date format: September 22, 2026" android:textColor="@color/muted" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp"/>
  <TextView android:text="Finance Manager: Mohammad Hussain Afshar" android:textColor="@color/muted" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
  <TextView android:text="+93772254205   •   hussainafshar7@gmail.com" android:textColor="@color/muted" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
 </LinearLayout>
</ScrollView>
